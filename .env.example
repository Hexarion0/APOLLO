# APOLLO Master Environment Configuration

# NVIDIA NIM / LLM Provider Configuration
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b,meta/llama-3.2-11b-vision-instruct
NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_TEMPERATURE=0.7
NVIDIA_TOP_P=1.0
NVIDIA_MAX_TOKENS=2048
NVIDIA_TIMEOUT=90.0

# Telegram Channel Configuration
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_OWNER_ID=6579740425
TELEGRAM_TYPING_INDICATOR=true

# Gateway Execution Controls
GATEWAY_MAX_TURNS=12
CHAT_HISTORY_LIMIT=10
PERSONA_FILE=persona.txt
STARTUP_NOTIFICATION=true
STARTUP_MESSAGE=🚀 **APOLLO Online**: System booted and services are operational.

# Autonomous Proactive Check-ins
PROACTIVE_ENABLED=true
PROACTIVE_INTERVAL_HOURS=4

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Security & Data Paths
POLICY_FILE=policy.json
AUDIT_LOG_FILE=audit.log
CHAT_LOG_FILE=chat.log
DATABASE_PATH=apollo.db
